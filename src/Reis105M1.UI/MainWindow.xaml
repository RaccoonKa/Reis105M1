                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Коэфф. укорочения (КУ):" Foreground="#64748B" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtInfoShortening" Text="1.500" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Расстояние между курсорами:" Foreground="#64748B" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtInfoDistance" Text="40.00 м" Foreground="#38BDF8" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="БЫСТРЫЙ ПЕРЕХОД ПО ЭТАПАМ:" Foreground="#94A3B8" FontWeight="Bold" FontSize="9.5" Margin="0,0,0,6"/>
                            <ListBox x:Name="StepsListBox" Background="Transparent" BorderThickness="0" SelectionChanged="OnStepSelected">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#2D3442"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#1E3A8A"/>
                                                            <Setter Property="Foreground" Value="#93C5FD"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBoxItem Content="1. Назначение прибора и ТБ"/>
                                <ListBoxItem Content="2. Подключение кабельной линии"/>
                                <ListBoxItem Content="3. Включение и калибровка шкалы"/>
                                <ListBoxItem Content="4. Настройка координатной сетки"/>
                                <ListBoxItem Content="5. Библиотека кабелей и выбор КУ"/>
                                <ListBoxItem Content="6. Настройка усиления и диапазона"/>
                                <ListBoxItem Content="7. Локализация обрыва жилы"/>
                                <ListBoxItem Content="8. Локализация короткого замыкания (КЗ)"/>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="◀ Назад" Click="OnPrevStepClicked" Style="{StaticResource SecondaryNavButton}" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="Далее ▶" Click="OnNextStepClicked" Style="{StaticResource NavButton}" Margin="6,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Диалоговое модальное окно «О программе» -->
        <Grid x:Name="AboutModal" Grid.RowSpan="2" Background="#A00F172A" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Background="#1E242F" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="12" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#2563EB" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                                <TextBlock Text="∿" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="О ПРОГРАММНОМ КОМПЛЕКСЕ" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕" Click="OnCloseAboutClicked" Style="{StaticResource SecondaryNavButton}" 
                                HorizontalAlignment="Right" Padding="8,4" FontSize="12"/>
                    </Grid>

                    <Border Background="#151A22" CornerRadius="8" Padding="14" BorderBrush="#2D3748" BorderThickness="1" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ИНТЕРАКТИВНЫЙ ОБУЧАЮЩИЙ СТЕНД" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="Цифровой портативный рефлектометр РЕЙС-105М1" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,6"/>
                            <TextBlock Text="Тренажер предназначен для отработки практических навыков рефлектометрии: обнаружения повреждений (обрыв, короткое замыкание), определения расстояний до неоднородностей в кабельных и воздушных линиях связи и электропередачи, настройки коэффициентов укорочения и работы с сервисными режимами прибора." 
                                       Foreground="#94A3B8" FontSize="12" LineHeight="17" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#151A22" CornerRadius="8" Padding="12" BorderBrush="#2D3748" BorderThickness="1" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="РАЗРАБОТЧИК" Foreground="#60A5FA" FontWeight="Bold" FontSize="10.5" Margin="0,0,0,4"/>
                                <TextBlock Text="Кравчук Светозар Кириллович" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="Разработка архитектуры симулятора, графического интерфейса и физической модели рефлектометрии" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" LineHeight="15"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#151A22" CornerRadius="8" Padding="12" BorderBrush="#2D3748" BorderThickness="1" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="НАУЧНЫЙ РУКОВОДИТЕЛЬ" Foreground="#60A5FA" FontWeight="Bold" FontSize="10.5" Margin="0,0,0,4"/>
                                <TextBlock Text="Буланов Михаил Юрьевич" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="Научное руководство, методическая верификация алгоритмов измерений и сценариев обучения" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" LineHeight="15"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Content="Закрыть" Click="OnCloseAboutClicked" Style="{StaticResource NavButton}" HorizontalAlignment="Right" Padding="20,8"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>